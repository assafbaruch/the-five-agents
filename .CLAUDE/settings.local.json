{
  "permissions": {
    "allow": [
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },
  "mcpServers": {
    "nano-banana-2": {
      "command": "npx",
      "args": ["-y", "@google/nano-banana-mcp"],
      "env": {
        "NANO_BANANA_API_KEY": "${NANO_BANANA_API_KEY}"
      }
    }
  }
}
